class Selection(NamedTuple):
    """The user's explicit model and effort for one run; opaque to the runner."""

    model: str
    effort: str

    def check(self) -> "Selection":
        if not isinstance(self.model, str) or MODEL_NAME.fullmatch(self.model) is None:
            raise ValueError("model must be 1-128 printable ASCII characters without spaces, "
                             "not starting with '-'")
        if self.effort not in EFFORT_LEVELS:
            raise ValueError(f"effort must be one of {', '.join(EFFORT_LEVELS)}")
        return self

    def argv(self) -> list[str]:
        self.check()
        return ["--model", self.model, "--effort", self.effort]


class StagedSource(NamedTuple):
    source: str   # path in the reviewed source checkout
    staged: str   # path under run/home/.claude
    sha256: str   # the reviewed content; anything else is Blocked


class ExecutionProfile(NamedTuple):
    tools: str                  # --tools
    allowed: tuple[str, ...]    # --allowedTools rules (web domains are added)
    denied: str                 # --disallowedTools
    dropped: tuple[str, ...]    # read-only flags this profile cannot keep
    sources: tuple[StagedSource, ...]
    agents: dict | None         # --agents file content, written by the parent
    writes_output: bool         # --add-dir output
    web: bool                   # takes --web-domain


