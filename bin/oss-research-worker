class StagedRun(NamedTuple):
    """A corpus-extract or deep-research run: its profile, the reviewed source
    checkout its files are staged from, and the WebFetch domains (default none)."""

    profile: str
    source_root: Path
    web_domains: tuple[str, ...] = ()

    @property
    def spec(self) -> ExecutionProfile:
        return STAGED_PROFILES[self.profile]

    def check(self) -> "StagedRun":
        """Raise ValueError unless the profile is staged and every domain is allowed."""
        if self.profile not in STAGED_PROFILES:
            raise ValueError("staged execution profile must be one of "
                             + ", ".join(STAGED_PROFILES))
        if self.web_domains and not self.spec.web:
            raise ValueError("web domains are for the deep-research profile only")
        if len(self.web_domains) > MAX_WEB_DOMAINS:
            raise ValueError(f"at most {MAX_WEB_DOMAINS} web domains")
        if len(set(self.web_domains)) != len(self.web_domains):
            raise ValueError("web domains must be unique")
        for domain in self.web_domains:
            if WEB_DOMAIN.match(domain) is None:
                raise ValueError(f"web domain must be a lowercase host name: {domain!r}")
            if any(domain == name or domain.endswith("." + name) for name in GITHUB_DOMAINS):
                raise ValueError(f"GitHub domains are read through the relay only: {domain}")
        return self


def checked_staged_input(input_dir: Path) -> None:
    """Without --safe-mode Claude loads CLAUDE.md and project config from the
    working directory, so a staged run refuses input that holds any. A
    directory that cannot be listed fails the check instead of being skipped."""

    def unreadable(error: OSError) -> None:
        raise ValueError(f"input cannot be fully listed: {error.strerror}")

    for current, directories, files in os.walk(input_dir, onerror=unreadable):
        for name in directories + files:
            if name in INPUT_CONFIG_NAMES:
                raise ValueError("input holds Claude configuration: "
                                 f"{(Path(current) / name).relative_to(input_dir)}")


def reject_symlinks(root: Path) -> None:
    for current, directories, files in os.walk(root):
        for name in directories + files:
            if (Path(current) / name).is_symlink():
                raise ValueError(f"symlink is not allowed: {Path(current) / name}")


def checked_input(input_dir: Path, prompt_file: Path, home: Path) -> tuple[Path, str]:
    if input_dir.is_symlink() or prompt_file.is_symlink():
        raise ValueError("input directory and prompt must not be symlinks")
    input_dir = input_dir.resolve(strict=True)
    if not input_dir.is_dir():
        raise ValueError("input must be a directory")
    if home.resolve().is_relative_to(input_dir):
        raise ValueError("input directory must not contain the parent HOME")
    reject_symlinks(input_dir)
    resolved = prompt_file.resolve(strict=True)
    if not resolved.is_file() or not resolved.is_relative_to(input_dir):
        raise ValueError("prompt must be a regular file inside the input directory")
    if resolved.stat().st_size > MAX_PROMPT_BYTES:
        raise ValueError("prompt is too large")
    # One read of the bytes, strict UTF-8, newlines kept: the child gets exactly
    # the file's text and prompt_sha256 is the file's bytes (no read_text CRLF
    # translation, no second read).
    try:
        prompt = resolved.read_bytes().decode("utf-8")
    except UnicodeDecodeError:
        raise ValueError("prompt must be nonempty UTF-8 text without NUL") from None
    if not prompt.strip() or "\0" in prompt:
        raise ValueError("prompt must be nonempty UTF-8 text without NUL")
    return input_dir, prompt


def checked_run_dir(run_dir: Path, input_dir: Path) -> Path:
    if run_dir.exists() or run_dir.is_symlink():
        raise ValueError("run directory must not exist yet")
    parent = run_dir.parent.resolve(strict=True)
    run_dir = parent / run_dir.name
    if run_dir.is_relative_to(input_dir) or input_dir.is_relative_to(run_dir):
        raise ValueError("run and input directories must not overlap")
    return run_dir


def tree_sha256(root: Path) -> str:
    """Digest of every name, file content and link target under root.

    npm's hidden lockfile is skipped: it only differs by the prefix name.
    """
    digest = hashlib.sha256()
    for path in sorted(root.rglob("*")):
        relative = path.relative_to(root).as_posix()
        if relative == ".package-lock.json":
            continue
        if path.is_symlink():
            entry = ["link", relative, os.readlink(path)]
        elif path.is_file():
            entry = ["file", relative, hashlib.sha256(path.read_bytes()).hexdigest()]
        elif path.is_dir():
            entry = ["dir", relative]
        else:
            raise Blocked(f"special file in the sandbox runtime install: {relative}")
        digest.update(json.dumps(entry).encode() + b"\n")
    return digest.hexdigest()


def verify_runtime(prefix: Path | None, path: str | None) -> list[str]:
    """Return the argv that starts the pinned srt, or raise Blocked.

    srt on PATH is never used: only the prefix whose lock, package version
    and installed tree match the measured 0.0.77 install.
    """
    if prefix is None:
        raise Blocked("no --runtime-prefix given; srt (sandbox runtime) is not "
                      "installed for this worker; not starting unisolated")
    prefix = prefix.resolve()
    modules = prefix / "node_modules"
    package = modules / SRT_PACKAGE
    cli = package / "dist/cli.js"
    if not cli.is_file():
        raise Blocked(f"srt (sandbox runtime) is not installed in {prefix}; "
                      "not starting unisolated")
    try:
        lock = json.loads((prefix / "package-lock.json").read_text(encoding="utf-8"))
        locked = {name.removeprefix("node_modules/"): (entry["version"], entry["integrity"])
                  for name, entry in lock["packages"].items() if name}
        installed = json.loads((package / "package.json").read_text(encoding="utf-8"))
    except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
        raise Blocked(f"sandbox runtime lock or package file is unusable: {error}")
    if locked != SRT_LOCKED:
        raise Blocked(f"locked packages are not the pinned {SRT_PACKAGE}@{SRT_VERSION} "
                      "set with its measured dependency versions and integrity")
    if installed.get("name") != SRT_PACKAGE or installed.get("version") != SRT_VERSION:
        raise Blocked(f"installed sandbox runtime is not {SRT_PACKAGE}@{SRT_VERSION}")
    if tree_sha256(modules) != SRT_TREE_SHA256:
        raise Blocked("installed sandbox runtime tree differs from the measured "
                      f"{SRT_VERSION} install")
    node = shutil.which("node", path=path)
    if node is None:
        raise Blocked("node is not on PATH; srt cannot start")
    return [node, str(cli)]


def system_read(platform: str) -> tuple[str, ...]:
    """The system paths the policy opens on this platform, or Blocked."""
    if platform not in SYSTEM_READ_BY_PLATFORM:
        raise Blocked(f"no sandbox policy for platform {platform!r}; not starting unisolated")
    return SYSTEM_READ_BY_PLATFORM[platform]


def apply_seccomp_path(prefix: Path, machine: str) -> Path:
    """The pinned tree's apply-seccomp for this machine, or Blocked."""
    if machine not in SECCOMP_ARCHES:
        raise Blocked(f"srt {SRT_VERSION} has no apply-seccomp for {machine!r}")
    return (prefix / "node_modules" / SRT_PACKAGE / "vendor/seccomp"
            / SECCOMP_ARCHES[machine] / "apply-seccomp")


def ancestor_problems(label: str, path: Path, owner: int, root: Path) -> list[str]:
    """Every directory above path, as written and as resolved, up to and
    including root: owned by owner and not writable by group or others.

    Otherwise whoever may write one of them can rename what lies below and
    put another file in its place between this check and the launch.
    """
    root = Path(os.path.realpath(root))
    chains = {Path(os.path.abspath(path)).parent, Path(os.path.realpath(path)).parent}
    problems = []
    for start in sorted(chains):
        if start != root and root not in start.parents:
            problems.append(f"{label} is outside {root}: {start}")
            continue
        for directory in [start, *start.parents]:
            try:
                info = os.stat(directory)
            except OSError as error:
                problems.append(f"{label}: directory {directory} is unusable: {error.strerror}")
                break
            if info.st_uid != owner:
                problems.append(f"{label}: directory {directory} is not owned by uid {owner}")
            elif info.st_mode & 0o022:
                problems.append(f"{label}: directory {directory} is writable by group or others")
            if directory == root:
                break
    return problems


def file_problems(label: str, path: Path, owner: int, root: Path,
                  executable: bool = True) -> list[str]:
    """A regular, owner-held file nobody else can change or replace, never set-id.

    A symlink is followed once and its target checked the same way; the
    directories above both spellings are checked up to root (ancestor_problems).
    """
    try:
        info = os.stat(path)
    except OSError as error:
        return [f"{label} is unusable: {error.strerror}"]
    problems = []
    if not stat.S_ISREG(info.st_mode):
        problems.append(f"{label} is not a regular file")
    if info.st_uid != owner:
        problems.append(f"{label} must be owned by uid {owner}")
    if info.st_mode & 0o022:
        problems.append(f"{label} is writable by group or others")
    if info.st_mode & (stat.S_ISUID | stat.S_ISGID):
        problems.append(f"{label} is set-id")
    if executable and not info.st_mode & stat.S_IXUSR:
        problems.append(f"{label} is not executable")
    return problems + ancestor_problems(label, path, owner, root)


def tree_owner_problems(prefix: Path, owner: int, root: Path,
                        label: str = "srt prefix") -> list[str]:
    """The srt prefix lies under root/opt, its ancestors are owner-held and
    closed (ancestor_problems), and every entry in it is owned by owner, not
    writable by group or others, no special file, no link leading outside it.
    The first offender inside the prefix is reported. label names the tree in
    messages (the Linux unit wrapper checks its source tree the same way)."""
    trusted = Path(os.path.realpath(root / LINUX_RUNTIME_PARENT.relative_to("/")))
    resolved = Path(os.path.realpath(prefix))
    if trusted not in resolved.parents:
        return [f"{label} must be installed under {LINUX_RUNTIME_PARENT}: {resolved}"]
    # A name below the tree, so the directory checks start at the tree itself.
    problems = ancestor_problems(label, resolved / "-", owner, root)

    def offender(path: Path) -> str | None:
        info = os.lstat(path)
        if info.st_uid != owner:
            return f"{label} entry is not owned by uid {owner}: {path}"
        if stat.S_ISLNK(info.st_mode):
            target = Path(os.path.realpath(path))
            if target != resolved and resolved not in target.parents:
                return f"{label} link leads outside it: {path}"
            return None
        if not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
            return f"special file in the {label}: {path}"
        if info.st_mode & 0o022:
            return f"{label} entry is writable by group or others: {path}"
        return None

    errors: list[OSError] = []
    try:
        for current, directories, files in os.walk(resolved, onerror=errors.append):
            for name in directories + files:
                if found := offender(Path(current) / name):
                    return problems + [found]
    except OSError as error:
        return problems + [f"{label} cannot be checked: {error.strerror}"]
    if errors:
        return problems + [f"{label} cannot be fully listed: {errors[0].strerror}"]
    return problems


def read_proc(path: Path) -> str | None:
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None


def linux_static_problems(prefix: Path, *, root: Path = Path("/"),
                          machine: str | None = None, euid: int | None = None,
                          owner: int = 0) -> list[str]:
    """What rules out a Linux launch, read from files only: no process starts.

    The tools and the whole srt prefix must belong to owner (root), and so must
    every directory above them: the guest installs srt as root under /opt, so
    the research user can run it but never change or replace it between this
    check and the launch. root, machine, euid and owner exist for
    the fake-host tests;
    the runner passes none of them. Anything that cannot be read is a problem.
    Whether bubblewrap and apply-seccomp actually get their namespaces is not
    known from files; linux_execution_preflight starts them, apart from main.
    """
    machine = os.uname().machine if machine is None else machine
    euid = os.geteuid() if euid is None else euid
    problems = []
    if euid == 0:
        problems.append("running as uid 0; the research user must be unprivileged")
    version = read_proc(root / "proc/version")
    if version is None:
        problems.append("cannot read /proc/version")
    elif "microsoft" in version.lower() and "wsl2" not in version.lower():
        problems.append("WSL1 has no bubblewrap support")
    for tool in LINUX_TOOLS:
        problems += file_problems(tool, root / LINUX_TOOL_DIR.relative_to("/") / tool,
                                  owner, root)
    problems += tree_owner_problems(prefix, owner, root)
    try:
        seccomp = apply_seccomp_path(prefix, machine)
    except Blocked as error:
        problems.append(str(error))
    else:
        if seccomp.is_symlink():
            problems.append("apply-seccomp must not be a symlink")
        else:
            problems += file_problems("apply-seccomp", seccomp, owner, root)
    limit = (read_proc(root / "proc/sys/user/max_user_namespaces") or "").strip()
    if not limit.isascii() or not limit.isdigit():
        problems.append("cannot read user.max_user_namespaces as an integer")
    elif int(limit) == 0:
        problems.append("user namespaces are disabled (user.max_user_namespaces = 0)")
    clone = root / "proc/sys/kernel/unprivileged_userns_clone"
    if clone.exists() and (read_proc(clone) or "").strip() != "1":
        problems.append("unprivileged user namespaces are disabled or unreadable")
    if not (root / "sys/fs/cgroup/cgroup.controllers").is_file():
        problems.append("cgroup v2 is not mounted at /sys/fs/cgroup")
    mounts = read_proc(root / "proc/self/mountinfo")
    if mounts is None:
        problems.append("cannot read /proc/self/mountinfo")
    else:
        for line in mounts.splitlines():
            fields = line.partition(" - ")[2].split()
            if fields and fields[0] in HOST_MOUNT_TYPES:
                problems.append(f"host share mounted: {fields[0]} at {line.split()[4]}")
    return problems


# Exit 0 when socket(AF_UNIX) is created, 3 when a policy refuses it (EPERM,
# EACCES), 4 on any other error (EMFILE, ENOMEM, ...), which proves nothing.
# srt 0.0.77's filter is expected to return EPERM (the helper binary names
# only that errno). The Debian guest run gave exit 3; the errno itself was not recorded.
AF_UNIX_PROBE = ("import errno,socket,sys\n"
                 "try:\n socket.socket(socket.AF_UNIX).close()\n"
                 "except OSError as error:\n"
                 " print(error.errno)\n"
                 " sys.exit(3 if error.errno in (errno.EPERM, errno.EACCES) else 4)\n")


def linux_execution_preflight(prefix: Path, environ: dict[str, str], *,
                              machine: str | None = None, python: str | None = None,
                              run=subprocess.run) -> list[str]:
    """Start bubblewrap and apply-seccomp once each and report what failed.

    This starts processes, so main never calls it: the guest task runs it by
    hand next to the static check, passing the research user's environment,
    which must hold no SSH agent. The AF_UNIX result counts only beside its
    control: the same probe must create the socket outside apply-seccomp.
    """
    machine = os.uname().machine if machine is None else machine
    python = str(Path(sys.executable).resolve()) if python is None else python
    environment = {"PATH": LINUX_PATH}
    problems = []
    if "SSH_AUTH_SOCK" in environ:
        problems.append("SSH_AUTH_SOCK is set; no SSH agent may reach the research user")
    try:
        seccomp = str(apply_seccomp_path(prefix, machine))
    except Blocked as error:
        return problems + [str(error)]
    bwrap = [str(LINUX_TOOL_DIR / "bwrap"), "--unshare-user", "--unshare-pid",
             "--unshare-net", "--ro-bind", "/", "/", "--proc", "/proc", "--dev", "/dev",
             "/bin/true"]
    probe = [python, "-I", "-c", AF_UNIX_PROBE]
    checks = (("bubblewrap namespaces", bwrap, 0),
              ("apply-seccomp start", [seccomp, "/bin/true"], 0),
              ("AF_UNIX control", probe, 0),
              ("AF_UNIX under apply-seccomp", [seccomp, *probe], 3))
    for label, argv, expected in checks:
        try:
            completed = run(argv, env=environment, stdin=subprocess.DEVNULL,
                            capture_output=True, text=True, timeout=LINUX_PREFLIGHT_SECONDS)
        except (OSError, subprocess.SubprocessError) as error:
            problems.append(f"{label}: {type(error).__name__}")
            continue
        if completed.returncode != expected:
            problems.append(f"{label}: exit {completed.returncode}, expected {expected}")
    return problems


def platform_problems(prefix: Path, platform: str) -> list[str]:
    """The file-only checks require_runtime adds per platform (none on macOS)."""
    system_read(platform)
    if platform == "linux":
        return linux_static_problems(prefix)
    return []


# Set by the Linux unit wrapper (oss-research-linux-run) on the unit
# it starts; its stdin is then the wrapper's pipe.
UNIT_ENV_MARKER = "OSS_RESEARCH_UNIT"
PARENT_GONE_EXIT = 75


def parent_eof_guard(environ: dict[str, str]) -> bool:
    """Inside the wrapper's unit, end this process once the wrapper is gone.

    The wrapper holds the only write end of this process's stdin. When the
    wrapper exits, for any reason including SIGKILL, stdin reads EOF and this
    process exits at once; the unit's KillMode=control-group then ends every
    process left in its cgroup (relay, srt, research child, setsid escapees).
    Children never hold that pipe: Supervisor starts them with stdin
    /dev/null and closes every other descriptor. Returns False without the
    marker, and raises Blocked when the marker is set but stdin is no pipe.
    """
    if UNIT_ENV_MARKER not in environ:
        return False
    try:
        if not stat.S_ISFIFO(os.fstat(0).st_mode):
            raise Blocked("unit stdin is not the wrapper's pipe; not running unguarded")
    except OSError as error:
        raise Blocked(f"unit stdin is unusable: {error.strerror}")

    def watch() -> None:
        try:
            while os.read(0, 4096):
                pass
        except OSError:
            pass
        os._exit(PARENT_GONE_EXIT)

    threading.Thread(target=watch, name="parent-eof-guard", daemon=True).start()
    return True


class Credential:
    """A checked token held in memory only. repr/str never show the value.

    secrets are the exact values the exposure checks look for: the value
    itself for a Claude token; for a Codex auth.json (whose text is the value)
    each token in it, since a copy of one token is an exposure on its own."""

    __slots__ = ("profile", "_value", "_secrets", "facts")

    def __init__(self, profile: str, value: str, secrets: tuple[str, ...] | None = None,
                 facts: dict | None = None):
        self.profile = profile
        self._value = value
        self._secrets = (value,) if secrets is None else tuple(secrets)
        self.facts = facts or {}

    def __repr__(self) -> str:
        return f"<credential for {self.profile}>"

    __str__ = __repr__

    def __reduce__(self):
        raise TypeError("a credential is never serialized")

    def reveal(self) -> str:
        """The value, for the child environment and exposure checks only."""
        return self._value

    def secrets(self) -> tuple[str, ...]:
        """Every exact value the exposure checks look for (never logged)."""
        return self._secrets

    def found_in(self, text: str) -> bool:
        return any(secret in text for secret in self._secrets)


def open_credential(profile: str, credential: Path,
                    forbidden: tuple[Path, ...],
                    backend: Backend = CLAUDE) -> tuple[int, os.stat_result]:
    """Open a private credential file bound to profile and return (descriptor, stat).

    The directory and the file are opened without following links, and the
    owner, mode and link count are checked on those descriptors, so what is
    checked is what a later read gets. Nothing is read. Messages never
    include the content. The file name, the profiles and the size bounds are
    the backend's (Claude: oauth-token, a 20..4097 byte token; Codex:
    auth.json, CODEX_CREDENTIAL_BYTES).
    """
    if credential.is_symlink() or credential.parent.is_symlink():
        raise Blocked("credential file and its directory must not be symlinks")
    credential = credential.absolute()
    name = backend.require("credential_name")
    if profile not in backend.require("profiles"):
        raise Blocked(f"profile {profile} is not a {backend.name} profile")
    if credential.name != name or credential.parent.name != profile:
        raise Blocked(f"credential file must be <dir>/{profile}/{name}")
    # Claude keeps its own profile list here, as measured; another backend's
    # credential path may name no profile of any backend.
    others = PROFILES if backend.name == CLAUDE.name else ALL_PROFILES
    if any(part in others for part in credential.parent.parent.parts):
        raise Blocked("credential path must name only its own profile")
    if any(credential.resolve().is_relative_to(path) for path in forbidden):
        raise Blocked("credential file must be outside the input and run directories")
    low, high, shape = ((20, CREDENTIAL_MAX_BYTES, "a single-line ASCII token")
                        if backend.name == CLAUDE.name
                        else (*CODEX_CREDENTIAL_BYTES, "a Codex ChatGPT login file"))
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    directory_fd = file_fd = None
    try:
        directory_fd = os.open(credential.parent, flags | os.O_DIRECTORY)
        file_fd = os.open(name, flags, dir_fd=directory_fd)
        directory, info = os.fstat(directory_fd), os.fstat(file_fd)
        if not stat.S_ISREG(info.st_mode):
            raise Blocked("credential file is not a regular file")
        for label, entry, mode in (("directory", directory, 0o700), ("file", info, 0o600)):
            if entry.st_uid != os.getuid() or stat.S_IMODE(entry.st_mode) != mode:
                raise Blocked(f"credential {label} must be owned by this user with mode {mode:o}")
        if info.st_nlink != 1:
            raise Blocked("credential file must have exactly one link")
        if not low <= info.st_size <= high:
            raise Blocked(f"credential file is not {shape}")
    except BaseException as error:
        if file_fd is not None:
            os.close(file_fd)
        if isinstance(error, OSError):
            if error.errno == errno.ELOOP:
                raise Blocked("credential file and its directory must not be symlinks")
            raise Blocked(f"credential file is unusable: {error.strerror}")
        raise
    finally:
        if directory_fd is not None:
            os.close(directory_fd)
    return file_fd, info


def checked_credential(profile: str, credential: Path, *forbidden: Path,
                       backend: Backend = CLAUDE) -> None:
    """Raise Blocked unless credential is a private file bound to profile.

    The closed gate uses this: path, owner, mode, link count and size only.
    The token itself is not read (load_credential does that).
    """
    os.close(open_credential(profile, credential, forbidden, backend)[0])


def read_credential(profile: str, credential: Path, forbidden: tuple[Path, ...],
                    backend: Backend) -> bytes:
    """One read of a checked credential file through its checked descriptor."""
    descriptor, info = open_credential(profile, credential, forbidden, backend)
    try:
        data = os.read(descriptor, info.st_size + 1)
        after = os.fstat(descriptor)
    except OSError as error:
        raise Blocked(f"credential file is unusable: {error.strerror}")
    finally:
        os.close(descriptor)
    if (after.st_size, after.st_mtime_ns) != (info.st_size, info.st_mtime_ns) \
            or len(data) != info.st_size:
        raise Blocked("credential file changed while it was read")
    return data


def load_credential(profile: str, credential: Path, *forbidden: Path,
                    backend: Backend = CLAUDE) -> Credential:
    """checked_credential plus one read of the token through the same descriptor.

    Called only past the gate (tests call it directly while it is closed).
    A Codex credential is a login file (load_codex_credential).
    """
    if backend.name == CODEX.name:
        return load_codex_credential(profile, credential, *forbidden)
    if backend.name != CLAUDE.name:
        backend.require("credential_name")
        raise Blocked(f"backend {backend.name} has no measured credential shape")
    descriptor, info = open_credential(profile, credential, forbidden)
    try:
        data = os.read(descriptor, CREDENTIAL_MAX_BYTES + 1)
        after = os.fstat(descriptor)
    except OSError as error:
        raise Blocked(f"credential file is unusable: {error.strerror}")
    finally:
        os.close(descriptor)
    if (after.st_size, after.st_mtime_ns) != (info.st_size, info.st_mtime_ns) \
            or len(data) != info.st_size:
        raise Blocked("credential file changed while it was read")
    try:
        token = data.decode("ascii")
    except UnicodeError:
        raise Blocked("credential file is not a single-line ASCII token")
    if not CREDENTIAL_PATTERN.fullmatch(token):
        raise Blocked("credential file is not a single-line ASCII token")
    return Credential(profile, token.removesuffix("\n"))


# A Codex ChatGPT login file (auth.json of Codex 0.162.1, AuthDotJson): auth_mode
# "chatgpt" (or absent), no API key, the three tokens and last_refresh. Any
# other key with a value (an API key, a personal access token, an agent
# identity, Bedrock keys) is refused: that is not the subscription login.
CODEX_CREDENTIAL_BYTES = (200, 65_536)
CODEX_TOKENS = ("id_token", "access_token", "refresh_token")
CODEX_TOKEN = re.compile(r"[!-~]{20,16384}")
CODEX_LOGIN_KEYS = {"auth_mode", "OPENAI_API_KEY", "tokens", "last_refresh"}
CODEX_TIMESTAMP = re.compile(r"(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.\d{1,9})?(?:Z|\+00:00)")
# Codex refreshes the token itself when it expires within 5 minutes or was
# last refreshed 8 days ago (login/src/auth/manager.rs). A run cannot reach
# auth.openai.com, so the parent refuses a login that would need a refresh
# within the run: every bound below is checked with the run's whole timeout.
CODEX_REFRESH_MARGIN_SECONDS = 300 + 60
CODEX_REFRESH_AGE_SECONDS = 8 * 24 * 3600
CODEX_CLOCK_SKEW_SECONDS = 300


def jwt_expiry(token: str) -> int | None:
    """The exp claim of a JWT (its payload only, never verified), or None."""
    parts = token.split(".")
    if len(parts) != 3:
        return None
    try:
        payload = json.loads(base64.urlsafe_b64decode(parts[1] + "=" * (-len(parts[1]) % 4)))
    except (ValueError, UnicodeError):
        return None
    expiry = payload.get("exp") if isinstance(payload, dict) else None
    return expiry if isinstance(expiry, int) and not isinstance(expiry, bool) else None


def load_codex_credential(profile: str, credential: Path, *forbidden: Path) -> Credential:
    """The Codex login file, read once like a Claude token, then its shape.

    Messages name keys only, never a value. The Credential's value is the
    file's text (the parent writes exactly that into the run); its secrets are
    the three tokens; its facts the access token's expiry and last_refresh."""
    data = read_credential(profile, credential, forbidden, CODEX)
    shape = "credential file is not a Codex ChatGPT login file"
    try:
        text = data.decode("utf-8")
        login = json.loads(text, object_pairs_hook=unique_object)
    except (UnicodeError, ValueError):
        raise Blocked(shape) from None
    if not isinstance(login, dict):
        raise Blocked(shape)
    extra = sorted(key for key, value in login.items()
                   if key not in CODEX_LOGIN_KEYS and value is not None)
    if extra:
        raise Blocked(f"{shape}: it holds {', '.join(extra)}")
    if login.get("OPENAI_API_KEY") is not None:
        raise Blocked(f"{shape}: it holds an API key (paid API auth is never used)")
    if login.get("auth_mode", "chatgpt") != "chatgpt":
        raise Blocked(f"{shape}: auth_mode is not chatgpt")
    tokens = login.get("tokens")
    if not isinstance(tokens, dict):
        raise Blocked(f"{shape}: no tokens")
    secrets = []
    for key in CODEX_TOKENS:
        value = tokens.get(key)
        if not isinstance(value, str) or CODEX_TOKEN.fullmatch(value) is None:
            raise Blocked(f"{shape}: tokens.{key} is missing or malformed")
        secrets.append(value)
    if len(set(secrets)) != len(secrets):
        raise Blocked(f"{shape}: two tokens are the same")
    expiry = jwt_expiry(tokens["access_token"])
    if expiry is None:
        raise Blocked(f"{shape}: tokens.access_token has no expiry")
    stamp = login.get("last_refresh")
    matched = CODEX_TIMESTAMP.fullmatch(stamp) if isinstance(stamp, str) else None
    if matched is None:
        raise Blocked(f"{shape}: last_refresh is missing or malformed")
    refreshed = calendar.timegm(time.strptime(matched.group(1), "%Y-%m-%dT%H:%M:%S"))
    return Credential(profile, text, tuple(secrets),
                      {"access_expires_at": expiry, "last_refresh_at": refreshed})


def codex_credential_problems(credential: Credential, seconds: float,
                              now: float | None = None) -> list[str]:
    """Why Codex might refresh its login during a run of seconds (never a value)."""
    now = time.time() if now is None else now
    facts = credential.facts
    problems = []
    if facts.get("access_expires_at", 0) < now + seconds + CODEX_REFRESH_MARGIN_SECONDS:
        problems.append("the Codex access token expires before the run could end; "
                        "refresh the login outside the run")
    refreshed = facts.get("last_refresh_at", 0)
    if refreshed > now + CODEX_CLOCK_SKEW_SECONDS:
        problems.append("the Codex login's last_refresh is in the future (clock?)")
    elif now + seconds + 60 - refreshed >= CODEX_REFRESH_AGE_SECONDS:
        problems.append("the Codex login is too old (Codex would refresh it); "
                        "refresh the login outside the run")
    return problems


class LaunchRequest(NamedTuple):
    """What main is about to start, compared field by field with MEASURED_LAUNCHES.

    unit_problems is why this process is not the unit wrapper's (unit_problems()
    on Linux); the measured launch ran in that unit, so any problem closes it."""
    execution_profile: str
    permission_mode: str
    relay: bool
    selection: "Selection | None"
    unit_problems: tuple[str, ...]
    backend: str = DEFAULT_BACKEND


UNIT_NAME = re.compile(r"oss-research-[0-9a-f]{16}")
PROC_CGROUP = Path("/proc/self/cgroup")


def unit_problems(environ: dict[str, str], guarded: bool) -> list[str]:
    """Why this process is not running inside the unit wrapper's unit.

    The marker alone proves nothing (anyone can set it). The wrapper's contract
    is: a root-checked tree, a systemd unit named by the marker, and this
    process's stdin as the wrapper's pipe (parent_eof_guard armed). So all
    three are required: the marker's form, the parent EOF guard, and this
    process's own cgroup being that unit's (cgroup v2, read from /proc).
    """
    marker = environ.get(UNIT_ENV_MARKER)
    if marker is None:
        return ["not started by the unit wrapper (no unit marker)"]
    problems = []
    if UNIT_NAME.fullmatch(marker) is None:
        problems.append("the unit marker is malformed")
    if not guarded:
        problems.append("the parent EOF guard is not armed")
    try:
        lines = PROC_CGROUP.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError):
        lines = []
    if lines != [f"0::/system.slice/{marker}.service"]:
        problems.append("this process is not in the wrapper unit's cgroup")
    return problems


def os_release(path: Path | None = None) -> dict[str, str]:
    """KEY=VALUE pairs of os-release (quotes removed), or {} when unreadable."""
    path = OS_RELEASE if path is None else path
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return {}
    pairs = {}
    for line in text.splitlines():
        key, sep, value = line.partition("=")
        if sep and key.strip() and not key.startswith("#"):
            pairs[key.strip()] = value.strip().strip("'\"")
    return pairs


def file_sha256(path: Path, limit: int = MAX_PINNED_BINARY_BYTES) -> str | None:
    """sha256 of a regular file of at most limit bytes, streamed; None otherwise."""
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_size > limit:
            return None
        digest = hashlib.sha256()
        while chunk := os.read(descriptor, 1 << 20):
            digest.update(chunk)
        return digest.hexdigest()
    finally:
        os.close(descriptor)


def measured_scope(platform: str, backend: str) -> MeasuredLaunch | None:
    """The measured launch a request of backend is compared with: that
    backend's own once it has one (MEASURED_BACKEND_LAUNCHES), otherwise the
    platform's Claude launch, which an unmeasured backend fails at its first field."""
    return MEASURED_BACKEND_LAUNCHES.get((backend, platform)) or MEASURED_LAUNCHES.get(platform)


def measured_launch_problems(platform: str, profile: str, launch: LaunchRequest | None) -> list[str]:
    """Why this launch is not the measured one (empty when it is exactly that)."""
    scope = measured_scope(platform, launch.backend if launch is not None else DEFAULT_BACKEND)
    if scope is None:
        return [f"no launch has been measured on {platform}"]
    if launch is None:
        return ["no launch request to compare with the measured launch"]
    problems = list(launch.unit_problems)
    selection = launch.selection
    for label, got, want in (
            ("backend", launch.backend, scope.backend),
            ("execution profile", launch.execution_profile, scope.execution_profile),
            ("permission mode", launch.permission_mode, scope.permission_mode),
            ("relay", "a relay" if launch.relay else "none", "a relay" if scope.relay else "none"),
            ("profile", profile, scope.profile),
            ("model", selection.model if selection else None, scope.model),
            ("effort", selection.effort if selection else None, scope.effort)):
        if got != want:
            problems.append(f"{label} {got} is not the measured {want}")
    return problems


def measured_runtime_problems(platform: str, runtime: list[str], path: str | None,
                              backend: Backend = CLAUDE) -> tuple[str | None, list[str]]:
    """(cli, problems): the host, node and the backend's CLI must be the measured ones."""
    scope = measured_scope(platform, backend.name)
    problems = []
    if backend.name != scope.backend:
        problems.append(f"backend {backend.name} is not the measured {scope.backend}")
    release = os_release()
    if (release.get("ID"), release.get("VERSION_ID")) != (scope.os_id, scope.os_version):
        problems.append(f"the host is not {scope.os_id} {scope.os_version}")
    if os.uname().machine != scope.machine:
        problems.append(f"the machine is not {scope.machine}")
    # The worker itself: root-held and unwritable, as the unit wrapper's bootstrap
    # checks its whole tree before it starts this file.
    problems += file_problems("worker", Path(os.path.realpath(__file__)), 0, Path("/"),
                              executable=False)
    node = Path(os.path.realpath(runtime[0]))
    problems += file_problems("node", node, 0, Path("/"))
    if file_sha256(node) != scope.node_sha256:
        problems.append("node is not the measured node (sha256)")
    found = shutil.which(backend.executable, path=path) if path else None
    if found is None:
        return None, problems + [f"{backend.executable} is not on PATH"]
    cli = Path(os.path.realpath(found))
    problems += file_problems(backend.executable, cli, 0, Path("/"))
    if file_sha256(cli) != scope.cli_sha256:
        problems.append(f"{backend.executable} is not the measured "
                        f"{backend.executable.capitalize()} (sha256)")
    return str(cli), problems


def require_runtime(profile: str, prefix: Path | None, path: str | None,
                    credential: Path | None = None,
                    forbidden: tuple[Path, ...] = (),
                    platform: str | None = None,
                    launch: LaunchRequest | None = None,
                    backend: Backend = CLAUDE) -> tuple[list[str], str, Credential]:
    """Raise Blocked unless this is exactly a launch that has been measured.

    The runtime and credential-file checks are real. On a platform with a
    measured launch (MEASURED_LAUNCHES; Linux only), the gate opens for that
    one configuration: every field of launch must match, and the host, node
    and the backend's CLI must be the measured files. Only then is the token
    read (load_credential) and returned. Anything else is Blocked, with the
    token unread: until those checks passed, only the credential's metadata is
    looked at. On Linux the file-only prerequisites are checked too; nothing
    is started for them (linux_execution_preflight is a separate, manual step).
    launch.backend must name backend; a backend without a measured launch
    (codex, agy) is Blocked here like any other unmeasured field.
    """
    platform = sys.platform if platform is None else platform
    runtime = verify_runtime(prefix, path)
    problems = platform_problems(Path(runtime[1]).parents[4], platform)
    if problems:
        raise Blocked(f"srt {SRT_VERSION} verified at {runtime[1]}, but this {platform} "
                      "host cannot run it isolated: " + "; ".join(problems))
    if launch is not None and launch.backend != backend.name:
        raise Blocked(f"isolated launch is closed: the launch request names backend "
                      f"{launch.backend}, not {backend.name}")
    scope_problems = measured_launch_problems(platform, profile, launch)
    if not SYSTEM_READ_MEASURED[platform] and scope_problems:
        # Only the measured launch stands in for the unmeasured read set.
        raise Blocked(
            f"isolated launch is closed: srt {SRT_VERSION} verified at {runtime[1]}, "
            f"but the {platform} system read set is not measured yet beyond the one measured "
            "launch: " + "; ".join(scope_problems))
    if credential is None:
        raise Blocked(
            f"isolated launch is closed: srt {SRT_VERSION} verified at {runtime[1]}, "
            f"but no credential binding for {profile}")
    if scope_problems and (backend.credential_name is None
                           or profile not in (backend.profiles or ())):
        # A backend with no credential shape (agy), or a profile that is not
        # the backend's: nothing to check, and the launch is closed anyway.
        raise Blocked(
            f"isolated launch is closed: srt {SRT_VERSION} verified at {runtime[1]}, "
            "but no real launch has been measured with it: " + "; ".join(scope_problems))
    checked_credential(profile, credential, *forbidden, backend=backend)
    if scope_problems:
        raise Blocked(
            f"isolated launch is closed: srt {SRT_VERSION} and the {profile} credential "
            "file are checked, but no real launch has been measured with them: "
            + "; ".join(scope_problems))
    cli, problems = measured_runtime_problems(platform, runtime, path, backend)
    if problems:
        raise Blocked("isolated launch is closed: this is not the measured runtime: "
                      + "; ".join(problems))
    return runtime, cli, load_credential(profile, credential, *forbidden, backend=backend)


def build_environment(parent: dict[str, str], run_dir: Path,
                      credential: Credential | None = None,
                      platform: str | None = None,
                      backend: Backend = CLAUDE) -> dict[str, str]:
    """The child's environment: the allowlist, run paths, the backend's
    configuration home under the run and, only when given, the checked
    credential in the backend's variable. The relay never gets it
    (relay_environment). On Linux PATH is LINUX_PATH, so srt finds the bwrap,
    socat and rg that linux_static_problems checked, never an earlier one on
    the parent's PATH. A backend without a measured configuration home or
    credential variable is Blocked before any environment exists. A backend
    that reads its credential from a file (Codex) gets no credential variable:
    the parent writes the file into the run (run_supervised). Its fixed
    variables (Backend.environment) come last; no parent value is inherited
    for them."""
    config_variable, config_subdir = backend.require("config_variable"), backend.require("config_subdir")
    by_variable = credential is not None and backend.credential_file is None
    credential_variable = backend.require("credential_variable") if by_variable else None
    environment = {name: parent[name] for name in INHERITED_VARIABLES if name in parent}
    if (sys.platform if platform is None else platform) == "linux":
        environment["PATH"] = LINUX_PATH
    environment["HOME"] = str(run_dir / "home")
    environment["TMPDIR"] = str(run_dir / "tmp")
    environment[config_variable] = str(run_dir / config_subdir)
    if by_variable:
        environment[credential_variable] = credential.reveal()
    environment.update(backend.environment)
    return environment


def runtime_prefix(runtime: list[str] | None) -> Path | None:
    """The srt prefix of a verify_runtime argv, or None for any other shape."""
    if runtime is None or len(runtime) < 2:
        return None
    cli = Path(runtime[1])
    tail = ("node_modules", *SRT_PACKAGE.split("/"), "dist", "cli.js")
    if cli.parts[-len(tail):] != tail:
        return None
    return cli.parents[len(tail) - 1]


def linux_link_targets(paths: list[str]) -> list[str]:
    """Resolved targets of the entries that are symlinks, not already listed."""
    targets = []
    for path in paths:
        target = os.path.realpath(path)
        if target != path and target not in paths and target not in targets:
            targets.append(target)
    return targets


def build_policy(input_dir: Path, run_dir: Path, cli: Path,
                 relay_port: int | None = None, model: bool = True,
                 staged: StagedRun | None = None, platform: str | None = None,
                 runtime: list[str] | None = None, backend: Backend = CLAUDE) -> dict:
    """srt settings using only keys documented in the sandbox-runtime README.

    The system read paths are the platform's (system_read). On Linux srt runs
    the pinned apply-seccomp inside bwrap, so the policy opens that one file,
    found from runtime (the argv verify_runtime returned); without runtime it
    is not opened and srt fails to start the command (measured, fail closed).

    The model endpoint (the backend's allowed domains) is allowed only for a
    model run (model=False is the non-AI relay-only probe, which needs no
    backend endpoint); the relay port only after its ready line checked.
    srt 0.0.77 rejects a network section without deniedDomains.
    A staged run adds its WebFetch domains and denies writes to every
    configuration path under the backend's configuration home (run/home/.claude);
    srt 0.0.77 also refused renaming their parent directories (measured,
    test_oss_research_worker_skills).
    """
    platform = sys.platform if platform is None else platform
    read = list(system_read(platform))
    targets = [str(input_dir), str(run_dir), str(cli)]
    if platform == "linux":
        read += backend.system_read_linux
        read += linux_link_targets(read)
        prefix = runtime_prefix(runtime)
        if prefix is not None and os.uname().machine in SECCOMP_ARCHES:
            read.append(str(apply_seccomp_path(prefix, os.uname().machine)))
        # An allowRead over the run directory re-binds the writable areas under
        # it read-only (srt 0.0.77 on Linux, measured); they stay readable as
        # allowWrite paths, and policy/ and result/ stay unreadable to the child.
        targets.remove(str(run_dir))
    domains = list(backend.require("allowed_domains_linux" if platform == "linux"
                                   else "allowed_domains")) if model else []
    deny_write = [str(run_dir / "policy"), str(run_dir / "result")]
    deny_write += [str(run_dir / backend.require("config_subdir") / name)
                   for name in backend.config_unwritable]
    if model and backend.credential_file is not None:
        # The parent's copy of the login: readable, never rewritten by the child.
        deny_write.append(str(run_dir / backend.require("config_subdir") / backend.credential_file))
    if staged is not None:
        domains += staged.check().web_domains
        config = run_dir / backend.require("config_subdir")
        deny_write += [str(config / name)
                       for name in (*PROTECTED_CONFIG_DIRECTORIES, *PROTECTED_CONFIG_FILES)]
    if relay_port is not None:
        domains.append(f"127.0.0.1:{relay_port}")
    policy = {
        "filesystem": {
            "denyRead": ["/"],
            "allowRead": [*read, *targets],
            "allowWrite": [str(run_dir / name) for name in WRITABLE_AREAS],
            "denyWrite": deny_write,
        },
        "network": {
            "allowedDomains": domains,
            "deniedDomains": [],
            "allowUnixSockets": [],
            "allowAllUnixSockets": False,
            "allowLocalBinding": False,
        },
    }
    if platform == "linux":
        policy["network"]["deniedResolvedAddresses"] = list(DENIED_RESOLVED_LINUX)
        # srt starts its in-sandbox proxy as `socat` from PATH, but it binds a
        # symlinked read entry at its target only, so Debian's /usr/bin/socat
        # (-> socat1) is absent inside and the proxy never listens (measured).
        # socatPath is in srt 0.0.77's settings schema (sandbox-config.js), not
        # its README; measured to take effect: with it the proxy answers.
        policy["socatPath"] = os.path.realpath(LINUX_TOOL_DIR / "socat")
    return policy


class RelayRequest(NamedTuple):
    repositories: tuple[str, ...]
    request_budget: int
    max_response_bytes: int
    response_byte_budget: int
    timeout_seconds: float


class RelayLaunch(NamedTuple):
    argv: list[str]
    environment: dict[str, str]
    sources: list[dict[str, str]]
    relay_sha256: str


def checked_relay_request(repositories: list[str], request_budget: int,
                          max_response_bytes: int, response_byte_budget: int,
                          timeout_seconds: float) -> RelayRequest:
    """Raise ValueError unless the relay arguments are inside the relay's own limits."""
    if not 1 <= len(repositories) <= MAX_RELAY_REPOSITORIES:
        raise ValueError(f"relay needs 1 to {MAX_RELAY_REPOSITORIES} repositories")
    for repository in repositories:
        if REPOSITORY.match(repository) is None:
            raise ValueError("relay repository must be OWNER/NAME")
    if len({repository.lower() for repository in repositories}) != len(repositories):
        raise ValueError("relay repositories must be unique")
    for label, value, limit in (("request budget", request_budget, MAX_RELAY_REQUEST_BUDGET),
                                ("max response bytes", max_response_bytes,
                                 MAX_RELAY_RESPONSE_BYTES),
                                ("response byte budget", response_byte_budget,
                                 MAX_RELAY_RESPONSE_BYTE_BUDGET)):
        if isinstance(value, bool) or not isinstance(value, int) or not 1 <= value <= limit:
            raise ValueError(f"relay {label} must be an integer from 1 to {limit}")
    if not (math.isfinite(timeout_seconds) and 0 < timeout_seconds <= MAX_RELAY_TIMEOUT_SECONDS):
        raise ValueError(f"relay timeout must be above 0 and at most {MAX_RELAY_TIMEOUT_SECONDS:g}")
    return RelayRequest(tuple(repositories), request_budget, max_response_bytes,
                        response_byte_budget, timeout_seconds)


def source_checkout(script: Path) -> Path | None:
    """The checkout root when script is <root>/bin/<name> of this repository
    (skills/ beside bin/), else None: an installed copy such as ~/.local/bin."""
    if script.parent.name == "bin" and (script.parent.parent / "skills").is_dir():
        return script.parent.parent
    return None


def trusted_relay(script: Path) -> tuple[Path, Path]:
    """The relay beside this script and the skills directory it must load.

    In a source checkout both come from the same checkout; installed,
    the relay is ~/.local/bin/oss-research-relay and the skills ~/.codex/skills.
    """
    script = script.resolve()
    root = source_checkout(script)
    if root is not None:
        relay = script.with_name("oss-research-relay")
        skills = root / "skills"
    else:
        relay = script.with_name("oss-research-relay")
        skills = Path.home() / ".codex/skills"
    if relay.is_symlink() or not relay.is_file():
        raise Blocked(f"the read-only relay is not installed beside the worker: {relay}")
    return relay, skills


def relay_sources(skills: Path) -> list[dict[str, str]]:
    """The provenance the relay's ready line must report, hashed by the parent."""
    sources = []
    for role, relative in RELAY_SOURCES:
        try:
            path = (skills / relative).resolve(strict=True)
            digest = hashlib.sha256(path.read_bytes()).hexdigest()
        except OSError as error:
            raise Blocked(f"relay source {relative} is unusable: {error.strerror}")
        sources.append({"role": role, "path": str(path), "sha256": digest})
    return sources


def relay_environment(parent: dict[str, str]) -> dict[str, str]:
    """The relay is credential-free: no GitHub token or proxy variable reaches it."""
    environment = {name: parent[name] for name in INHERITED_VARIABLES if name in parent}
    environment["PYTHONDONTWRITEBYTECODE"] = "1"
    return environment


def relay_launch(request: RelayRequest, parent: dict[str, str]) -> RelayLaunch:
    relay, skills = trusted_relay(Path(__file__))
    argv = [str(Path(sys.executable).resolve()), "-B", str(relay)]
    for repository in request.repositories:
        argv += ["--repo", repository]
    argv += ["--request-budget", str(request.request_budget),
             "--max-response-bytes", str(request.max_response_bytes),
             "--response-byte-budget", str(request.response_byte_budget),
             "--timeout-seconds", repr(request.timeout_seconds),
             "--skills-dir", str(skills)]
    return RelayLaunch(argv, relay_environment(parent), relay_sources(skills),
                       hashlib.sha256(relay.read_bytes()).hexdigest())


def unique_object(pairs: list[tuple[str, object]]) -> dict[str, object]:
    document = dict(pairs)
    if len(document) != len(pairs):
        raise ValueError("duplicate key")
    return document


def checked_ready(line: bytes, sources: list[dict[str, str]]) -> int:
    """Return the relay port, or raise ValueError when the ready line is not exact."""
    try:
        ready = json.loads(line.decode("utf-8"), object_pairs_hook=unique_object)
    except (UnicodeDecodeError, ValueError) as error:
        raise ValueError(f"ready line is not JSON: {error}")
    if not isinstance(ready, dict) or set(ready) != {"event", "host", "port", "base_url", "sources"}:
        raise ValueError("ready line does not hold exactly the ready fields")
    port = ready["port"]
    if ready["event"] != "ready" or ready["host"] != "127.0.0.1":
        raise ValueError("ready line is not a 127.0.0.1 ready event")
    if isinstance(port, bool) or not isinstance(port, int) or not 1 <= port <= 65_535:
        raise ValueError("ready port is not a TCP port")
    if ready["base_url"] != f"http://127.0.0.1:{port}":
        raise ValueError("ready base_url does not match the port")
    if ready["sources"] != sources:
        raise ValueError("relay sources differ from the parent-hashed skills")
    return port


def sandboxed(runtime: list[str], policy: Path, argv: list[str]) -> list[str]:
    return [*runtime, "--settings", str(policy), "--", *argv]


def require_measured_argv(backend: Backend) -> None:
    """Only the Claude argv below has been measured; another backend's argv
    (issue #6 stages 2 and 3) does not exist yet, so nothing is built for it."""
    if backend.name != CLAUDE.name:
        raise Blocked(f"backend {backend.name} has no measured argv; "
                      "the isolated launch stays closed")


# Codex 0.162.1, the tool-less text mode (issue #6: no dontAsk equivalent, so
# no tools at all). With CODEX_EXEC_SERVER_URL=none (build_environment) there
# is no shell, apply_patch, view_image or request_permissions; these remove the
# rest the model could otherwise get (hosted web search, image generation,
# sub-agents, cloud skills, goals, sleep, request_user_input) and every
# optional network use (apps MCP, plugin sync, analytics and Statsig metrics,
# endless reconnects). Nothing is loaded from the run's CODEX_HOME config,
# .rules, AGENTS.md in the input, hooks or bundled skills. exec itself forces
# approval never; --sandbox read-only stays (its sandbox has nothing to run).
CODEX_DISABLED_FEATURES = ("apps", "plugins", "image_generation", "goals", "sleep_tool",
                           "shell_snapshot", "unbounded_connection_retries", "hooks",
                           "shell_tool", "unified_exec", "view_image")
CODEX_CONFIG = (("web_search", '"disabled"'), ("agents.enabled", "false"),
                ("cloud.skills.enabled", "false"), ("skills.bundled.enabled", "false"),
                ("skills.include_instructions", "false"), ("analytics.enabled", "false"),
                ("project_doc_max_bytes", "0"),
                ("tools.experimental_request_user_input.enabled", "false"),
                ("check_for_update_on_startup", "false"))


def build_codex_command(runtime: list[str], policy: Path, cli: str, prompt: str,
                        permission_mode: str, selection: Selection | None) -> list[str]:
    """The Codex read-only run's argv: exec --json in the tool-less mode.

    permission_mode is the runner's only input mode (dontAsk); for Codex it
    means this tool-less mode, so anything else is refused. A model and an
    effort are always given (no Codex default is taken). The prompt is the
    last argument after --; the child's stdin is /dev/null, which exec reads
    as no additional input."""
    if permission_mode != DEFAULT_PERMISSION_MODE:
        raise ValueError(f"backend codex runs only the tool-less mode ({DEFAULT_PERMISSION_MODE})")
    if selection is None:
        raise Blocked("a codex run needs the user's explicit --model and --effort; "
                      "no default is chosen")
    selection.check()
    features = [argument for name in CODEX_DISABLED_FEATURES for argument in ("--disable", name)]
    config = [argument for key, value in CODEX_CONFIG for argument in ("-c", f"{key}={value}")]
    return sandboxed(runtime, policy, [
        cli, *features,
        "exec",
        "--json",
        "--ephemeral",
        "--skip-git-repo-check",
        "--ignore-rules",
        "--ignore-user-config",
        "--sandbox", "read-only",
        "--color", "never",
        *config,
        "--model", selection.model,
        "-c", f'model_reasoning_effort="{selection.effort}"',
        "--", prompt,
    ])


def build_command(runtime: list[str], policy: Path, cli: str, prompt: str,
                  permission_mode: str = DEFAULT_PERMISSION_MODE,
                  selection: Selection | None = None,
                  backend: Backend = CLAUDE) -> list[str]:
    """The read-only run's argv (the Claude backend's; require_measured_argv,
    or Codex's: build_codex_command).
    selection, when given, adds --model and --effort before the permission
    flags; without it the argv is unchanged."""
    if backend.name == CODEX.name:
        return build_codex_command(runtime, policy, cli, prompt, permission_mode, selection)
    require_measured_argv(backend)
    if permission_mode not in PERMISSION_MODES:
        raise ValueError(f"permission mode must be one of {', '.join(PERMISSION_MODES)}")
    return sandboxed(runtime, policy, [
        cli,
        "--print",
        "--output-format", "json",
        "--no-session-persistence",
        "--safe-mode",
        "--restricted",
        "--strict-mcp-config",
        "--no-chrome",
        "--disable-slash-commands",
        "--setting-sources", "",
        "--settings", json.dumps(CHILD_SETTINGS),
        *(selection.argv() if selection is not None else []),
        "--permission-mode", permission_mode,
        "--permission-prompts", "none",
        "--tools", READ_TOOLS,
        "--allowedTools", READ_TOOLS,
        "--disallowedTools", DENIED_TOOLS,
        "--max-turns", "20",
        "--", prompt,
    ])


def staged_rules(staged: StagedRun) -> tuple[list[str], list[str]]:
    """(allow, deny) permission rules: the profile's plus one WebFetch rule per domain."""
    allow = [*staged.spec.allowed, *(f"WebFetch(domain:{domain})"
                                     for domain in staged.web_domains)]
    return allow, staged.spec.denied.split(",")


def build_staged_command(runtime: list[str], policy: Path, cli: str, prompt: str,
                         run_dir: Path, staged: StagedRun,
                         permission_mode: str = DEFAULT_PERMISSION_MODE,
                         selection: Selection | None = None,
                         backend: Backend = CLAUDE) -> list[str]:
    """The argv of a corpus-extract or deep-research run (the Claude backend's).

    It is build_command's argv without the profile's dropped flags, plus the
    parent-written settings file, the profile's agents as one inline JSON
    object (corpus-extract) and the profile's tools and rules. --restricted,
    --strict-mcp-config and --setting-sources "" stay. The agents go inline
    because run/policy, where the parent also writes and records them
    (stage_research_config), is unreadable to the child by design
    (build_policy): a path there is "--agents file not found" to the CLI
    (measured 2026-10-13, Claude 2.1.283, before any model call).
    Building it says nothing about what Claude then loads or exposes.
    """
    require_measured_argv(backend)
    if permission_mode not in PERMISSION_MODES:
        raise ValueError(f"permission mode must be one of {', '.join(PERMISSION_MODES)}")
    spec = staged.check().spec
    allow, _ = staged_rules(staged)
    base = build_command(runtime, policy, cli, prompt, permission_mode, selection, backend)
    head = base[:base.index("--permission-mode")]
    head = [argument for argument in head if argument not in spec.dropped]
    # One --settings only: the staged settings file carries CHILD_SETTINGS.
    at = head.index("--settings", head.index(cli))
    head = head[:at] + head[at + 2:]
    extra = ["--settings", str(run_dir / "home/.claude/settings.json")]
    if spec.agents is not None:
        # The same object stage_research_config writes to run/policy/claude-agents.json
        # (recorded as agents_sha256); inline, since the child cannot read run/policy.
        extra += ["--agents", json.dumps(spec.agents)]
    if spec.writes_output:
        extra += ["--add-dir", str(run_dir / "output")]
    return [*head, *extra,
            "--permission-mode", permission_mode,
            "--permission-prompts", "none",
            "--tools", spec.tools,
            "--allowedTools", " ".join(allow),
            "--disallowedTools", spec.denied,
            "--max-turns", "20",
            "--", prompt]


def prepare_run(run_dir: Path, policy: dict, backend: Backend = CLAUDE) -> Path:
    run_dir.mkdir(mode=0o700)
    for name in (*WRITABLE_AREAS, "policy", "result"):
        (run_dir / name).mkdir(mode=0o700)
    config = run_dir / (backend.config_subdir or CLAUDE.config_subdir)
    config.mkdir(mode=0o700)
    for name in backend.config_unwritable:
        (config / name).mkdir(mode=0o700)
    policy_file = run_dir / "policy/srt-settings.json"
    policy_file.write_text(json.dumps(policy, indent=2), encoding="utf-8")
    policy_file.chmod(0o400)
    return policy_file


def reviewed_source_root(script: Path) -> Path:
    """The source checkout this worker runs from. An installed copy
    (~/.local/bin) has no reviewed source beside it, so nothing is staged."""
    if source_checkout(script) is None:
        raise Blocked("staged profiles run only from the reviewed source checkout; "
                      "installed skills are never staged")
    return script.resolve().parents[1]


def read_reviewed(root: Path, source: StagedSource) -> bytes:
    """The pinned source's bytes, read without following any link below root."""
    if root.is_symlink():
        raise Blocked(f"staged source root must not be a symlink: {root}")
    current = root
    for part in Path(source.source).parts[:-1]:
        current = current / part
        if current.is_symlink():
            raise Blocked(f"staged source directory must not be a symlink: {source.source}")
    try:
        descriptor = os.open(root / source.source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as error:
        if error.errno == errno.ELOOP:
            raise Blocked(f"staged source must not be a symlink: {source.source}")
        raise Blocked(f"staged source {source.source} is unusable: {error.strerror}")
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise Blocked(f"staged source is not a regular file: {source.source}")
        data = b""
        while chunk := os.read(descriptor, 1024 * 1024):
            data += chunk
    finally:
        os.close(descriptor)
    if hashlib.sha256(data).hexdigest() != source.sha256:
        raise Blocked(f"staged source {source.source} differs from the reviewed pin")
    return data


def write_staged(path: Path, data: bytes, mode: int) -> str:
    """Write a new file, read it back, and return its hash; Blocked if the copy differs."""
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        view = memoryview(data)
        while view:
            view = view[os.write(descriptor, view):]
    finally:
        os.close(descriptor)
    path.chmod(mode)
    expected = hashlib.sha256(data).hexdigest()
    if hashlib.sha256(path.read_bytes()).hexdigest() != expected:
        raise Blocked(f"staged copy differs from its source: {path.name}")
    return expected


def stage_research_config(run_dir: Path, staged: StagedRun) -> dict:
    """Copy the profile's reviewed sources into run/home/.claude and record them.

    Every source must match its pin; a symlink, a missing file or another
    hash is Blocked before anything is copied. The parent also writes the
    settings file (the same rules as the argv, hooks off) and, for
    corpus-extract, the agents file. The record goes to
    policy/staged-manifest.json; the child cannot write any of these (build_policy).
    """
    staged.check()
    spec = staged.spec
    contents = [(source, read_reviewed(staged.source_root, source)) for source in spec.sources]
    config = run_dir / "home/.claude"
    for name in PROTECTED_CONFIG_DIRECTORIES:
        (config / name).mkdir(mode=0o700)
    files = []
    for source, data in contents:
        files.append({"source": source.source, "staged": source.staged,
                      "sha256": write_staged(config / source.staged, data, 0o444)})
    allow, deny = staged_rules(staged)
    settings = json.dumps({"permissions": {"allow": allow, "deny": deny},
                           "disableAllHooks": True, **CHILD_SETTINGS}, indent=2).encode()
    files.append({"source": None, "staged": "settings.json",
                  "sha256": write_staged(config / "settings.json", settings, 0o444)})
    record = {"profile": staged.profile, "source_root": str(staged.source_root.resolve()),
              "web_domains": list(staged.web_domains), "files": files}
    if spec.agents is not None:
        record["agents_sha256"] = write_staged(
            run_dir / "policy/claude-agents.json",
            json.dumps(spec.agents, indent=2).encode(), 0o400)
    write_staged(run_dir / "policy/staged-manifest.json",
                 json.dumps(record, indent=2).encode(), 0o400)
    return record


def staged_problems(run_dir: Path, record: dict) -> list[str]:
    """After the run: every staged file unchanged, nothing added to the
    protected configuration, and the parent's manifest and agents file intact."""
    config = run_dir / "home/.claude"
    problems = []

    def digest(path: Path) -> str | None:
        try:
            if path.is_symlink() or not path.is_file():
                return None
            return hashlib.sha256(path.read_bytes()).hexdigest()
        except OSError:
            return None

    expected = {entry["staged"]: entry["sha256"] for entry in record["files"]}
    parents = {parent.as_posix() for name in expected
               for parent in Path(name).parents if parent != Path(".")}
    for name, sha in expected.items():
        if digest(config / name) != sha:
            problems.append(f"staged-changed: {name}")
    for name in PROTECTED_CONFIG_DIRECTORIES:
        directory = config / name
        if directory.is_symlink() or not directory.is_dir():
            problems.append(f"staged-changed: {name}")
            continue
        for path in sorted(directory.rglob("*")):
            relative = path.relative_to(config).as_posix()
            staged_directory = relative in parents and path.is_dir() and not path.is_symlink()
            if relative not in expected and not staged_directory:
                problems.append(f"staged-added: {relative}")
    for name in PROTECTED_CONFIG_FILES:
        path = config / name
        if name not in expected and (path.exists() or path.is_symlink()):
            problems.append(f"staged-added: {name}")
    manifest = json.dumps(record, indent=2).encode()
    if digest(run_dir / "policy/staged-manifest.json") != hashlib.sha256(manifest).hexdigest():
        problems.append("staged-manifest-changed")
    if "agents_sha256" in record and \
            digest(run_dir / "policy/claude-agents.json") != record["agents_sha256"]:
        problems.append("staged-changed: agents file")
    return problems


class Supervisor:
    """One monotonic deadline over every process group this parent starts.

    Every process gets its own session, so one killpg reaches it and the
    descendants that stay in its group. Output is read with select into
    bounded buffers (self.data); nothing waits without a deadline, cleanup
    included. A descendant that calls setsid leaves the group and is not
    reached by cleanup: its pipes are closed on it, but it may keep running.
    """

    def __init__(self, seconds: float):
        self.deadline = time.monotonic() + seconds
        self.processes: list[subprocess.Popen] = []
        self.failures: list[str] = []
        self.data: dict[str, bytes] = {"stdout": b"", "stderr": b"",
                                       "relay stdout": b"", "relay stderr": b""}

    def remaining(self) -> float:
        return max(0.0, self.deadline - time.monotonic())

    def fail(self, reason: str) -> None:
        if reason not in self.failures:
            self.failures.append(reason)

    def start(self, argv: list[str], environment: dict[str, str], cwd: Path,
              stdin=subprocess.DEVNULL) -> subprocess.Popen:
        """stdin is /dev/null for the relay and the research child, so neither
        holds a pipe of the parent's; only the Linux unit wrapper passes PIPE."""
        if self.remaining() <= 0:
            raise TimeoutError("deadline passed; no new process is started")
        process = subprocess.Popen(
            argv, cwd=cwd, env=environment, stdin=stdin,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
        self.processes.append(process)
        return process

    def _append(self, name: str, chunk: bytes, limit: int) -> bool:
        """Add chunk to a stream; False (and a failure) once it passes limit."""
        self.data[name] += chunk
        if len(self.data[name]) > limit:
            self.data[name] = self.data[name][:limit]
            self.fail(f"output-too-large: {name}")
            return False
        return True

    def read_ready(self, relay: subprocess.Popen) -> bytes | None:
        """The relay's first stdout line, newline included, of at most MAX_READY_BYTES.

        The relay's stderr is drained into its bounded buffer meanwhile.
        """
        streams = {relay.stdout.fileno(): "relay stdout", relay.stderr.fileno(): "relay stderr"}
        while True:
            remaining = self.remaining()
            if remaining <= 0:
                self.fail("timeout")
                return None
            ready, _, _ = select.select(list(streams), [], [], remaining)
            for descriptor in ready:
                name = streams[descriptor]
                # One byte at a time on stdout so nothing past the line is consumed.
                chunk = os.read(descriptor, 1 if name == "relay stdout" else 65_536)
                if not chunk:
                    if name == "relay stdout":
                        self.fail("relay-exited")
                        return None
                    del streams[descriptor]
                    continue
                if name == "relay stdout":
                    self.data[name] += chunk
                    if len(self.data[name]) > MAX_READY_BYTES:
                        self.fail("relay-ready-too-large")
                        return None
                    if chunk == b"\n":
                        line, self.data[name] = self.data[name], b""
                        return line
                elif not self._append(name, chunk, MAX_STDERR_BYTES):
                    return None

    def run(self, child: subprocess.Popen, relay: subprocess.Popen | None = None) -> int | None:
        """Wait for child and read its output into self.data; stop on any bound.

        Returns the child's exit code, or None when the supervisor stopped it.
        The relay must stay alive until cleanup: a relay that exits before the
        child's pipes close, even at the same moment as the child, fails the run.
        """
        streams = {child.stdout.fileno(): ("stdout", MAX_STDOUT_BYTES),
                   child.stderr.fileno(): ("stderr", MAX_STDERR_BYTES)}
        if relay is not None:
            streams[relay.stdout.fileno()] = ("relay stdout", MAX_READY_BYTES)
            streams[relay.stderr.fileno()] = ("relay stderr", MAX_STDERR_BYTES)
        child_pipes = {child.stdout.fileno(), child.stderr.fileno()}
        exited_at = None
        while True:
            if relay is not None and relay.poll() is not None:
                self.fail("relay-exited")
                return None
            if exited_at is None and child.poll() is not None:
                exited_at = time.monotonic()
            if exited_at is not None and not child_pipes & streams.keys():
                return child.returncode
            if exited_at is not None and time.monotonic() - exited_at > EXIT_GRACE_SECONDS:
                self.fail("child-pipes-held-open")
                return None
            remaining = self.remaining()
            if remaining <= 0:
                self.fail("timeout")
                return None
            ready, _, _ = select.select(list(streams), [], [], min(remaining, 0.1))
            for descriptor in ready:
                name, limit = streams[descriptor]
                chunk = os.read(descriptor, 65_536)
                if not chunk:
                    del streams[descriptor]
                elif not self._append(name, chunk, limit):
                    return None

    def cleanup(self) -> None:
        """Kill every group, reap within CLEANUP_SECONDS, and record survivors.

        Killed descendants may linger briefly as zombies of init, so a group
        counts as surviving only if it still exists when the cleanup time is up.
        """
        for process in self.processes:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
        until = time.monotonic() + CLEANUP_SECONDS
        for process in self.processes:
            try:
                process.wait(timeout=max(0.0, until - time.monotonic()))
            except subprocess.TimeoutExpired:
                self.fail(f"process-not-reaped: {process.pid}")
            for stream in (process.stdout, process.stderr):
                if stream is not None:
                    stream.close()
        for process in self.processes:
            while True:
                try:
                    os.killpg(process.pid, 0)
                except ProcessLookupError:
                    break
                except PermissionError:
                    pass
                if time.monotonic() >= until:
                    self.fail(f"process-group-survived: {process.pid}")
                    break
                time.sleep(0.05)


def text(data: bytes) -> str:
    return data.decode("utf-8", errors="replace")


def launch(command: list[str], environment: dict[str, str], cwd: Path,
           timeout: float) -> tuple[int | None, str, str]:
    """Run one child under a Supervisor without a relay.

    The exit code is None when the supervisor stopped the child; the reason is
    only in Supervisor.failures, so the CLI uses run_research instead.
    """
    supervisor = Supervisor(timeout)
    try:
        exit_code = supervisor.run(supervisor.start(command, environment, cwd))
    finally:
        supervisor.cleanup()
    if supervisor.failures:
        exit_code = None
    return exit_code, text(supervisor.data["stdout"]), text(supervisor.data["stderr"])


def parent_path_problems(run_dir: Path) -> list[str]:
    """The parent-only paths must still be what prepare_run created."""
    expected = {run_dir: "dir", run_dir / "result": "dir",
                run_dir / "policy": "dir", run_dir / "policy/srt-settings.json": "file"}
    problems = []
    for path, kind in expected.items():
        if path.is_symlink() or path.resolve() != path:
            problems.append(f"parent path moved: {path}")
        elif not (path.is_dir() if kind == "dir" else path.is_file()):
            problems.append(f"parent path is not a {kind}: {path}")
    if not problems and any((run_dir / "result").iterdir()):
        problems.append("result directory is not empty")
    return problems


def area_problems(run_dir: Path) -> list[str]:
    problems = []
    for name in WRITABLE_AREAS:
        area = run_dir / name
        if area.is_symlink() or not area.is_dir() or area.resolve() != area:
            problems.append(f"writable area {name} is not the created directory")
            continue
        for current, directories, files in os.walk(area):
            for entry in directories + files:
                path = Path(current) / entry
                if path.is_symlink():
                    problems.append(f"symlink in {name}: {path.relative_to(run_dir)}")
                elif not path.resolve().is_relative_to(area):
                    problems.append(f"path escape in {name}: {path.relative_to(run_dir)}")
                elif name == "output" and not (path.is_file() or path.is_dir()):
                    problems.append(f"special file in output: {path.relative_to(run_dir)}")
    return problems


class ExposureScan:
    """Look for the exact credential value in names and regular files under the
    writable areas, within EXPOSURE_MAX_FILES / _BYTES / _SECONDS.

    Past a bound the scan stops and counts as incomplete, which fails the run
    like an exposure. Links are not followed; special files are not read.
    """

    def __init__(self, value: str):
        self.needle = value.encode()
        self.files = self.bytes = 0
        self.until = time.monotonic() + EXPOSURE_SECONDS

    def bound(self) -> str | None:
        if self.files > EXPOSURE_MAX_FILES:
            return "files"
        if self.bytes > EXPOSURE_MAX_BYTES:
            return "bytes"
        if time.monotonic() > self.until:
            return "time"
        return None

    def file_holds(self, path: Path) -> bool:
        # Only regular files hold data to scan. Sockets (srt puts its proxy
        # sockets in run/tmp on Linux), FIFOs and devices are not opened: an
        # open of a socket fails and would leave the scan incomplete (measured).
        if not stat.S_ISREG(os.lstat(path).st_mode):
            return False
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        try:
            if not stat.S_ISREG(os.fstat(descriptor).st_mode):
                return False
            tail = b""
            while chunk := os.read(descriptor, 1024 * 1024):
                self.bytes += len(chunk)
                if self.needle in tail + chunk:
                    return True
                if self.bound():
                    return False
                tail = (tail + chunk)[-(len(self.needle) - 1):]
            return False
        finally:
            os.close(descriptor)

    def area(self, area: Path) -> str | None:
        """"exposed", "incomplete: <bound>", or None when the area is clean."""
        value = self.needle.decode()
        # Without onerror, os.walk skips a directory it cannot list and the
        # area would look clean; any listing error makes the scan incomplete.
        errors: list[OSError] = []
        for current, directories, files in os.walk(area, onerror=errors.append):
            if errors:
                return "incomplete: unreadable"
            for entry in directories + files:
                self.files += 1
                path = Path(current) / entry
                try:
                    if value in entry or (entry in files and not path.is_symlink()
                                          and self.file_holds(path)):
                        return "exposed"
                except OSError:
                    return "incomplete: unreadable"
                if reason := self.bound():
                    return f"incomplete: {reason}"
        return "incomplete: unreadable" if errors else None


def exposure_problems(run_dir: Path, credential: Credential,
                      streams: dict[str, str]) -> list[str]:
    """Where the exact credential value shows up: a stream, or a name or
    regular file under a writable area. Only the location is reported.

    Only the exact value is matched. Encoded, split or transformed copies
    (base64, escapes, reversed) are not found; see the docs for the limits.
    """
    problems = [f"credential-exposed: {name}" for name, data in streams.items()
                if credential.found_in(data)]
    # One scan per exact secret (Claude: the token; Codex: each of its tokens).
    for value in credential.secrets():
        scan = ExposureScan(value)
        for name in WRITABLE_AREAS:
            area = run_dir / name
            if area.is_symlink() or not area.is_dir():
                continue
            found = scan.area(area)
            if found == "exposed":
                problems.append(f"credential-exposed: {name}")
            elif found is not None:
                problems.append(f"credential-scan-{found.replace(': ', ': ' + name + ' ')}")
                return list(dict.fromkeys(problems))
    return list(dict.fromkeys(problems))


def require_profile(credential: Credential | None, profile: str) -> None:
    """Blocked when the credential was loaded for another profile."""
    if credential is not None and credential.profile != profile:
        raise Blocked(f"credential is bound to {credential.profile}, not {profile}")


def result_problems(exit_code: int | None, stdout: str,
                    backend: Backend = CLAUDE) -> tuple[list[str], str | None]:
    """(problems, report text) of the child's result in the backend's shape.
    Only the Claude result (--output-format json: a result object) is parsed;
    another backend's result is a problem, never a success."""
    if exit_code is None:
        return ["no exit code: the supervisor stopped the child"], None
    problems = [] if exit_code == 0 else [f"exit code {exit_code}"]
    if backend.name == CODEX.name:
        found, report = codex_events(stdout)
        return problems + found, report
    if backend.name != CLAUDE.name:
        return problems + [f"backend {backend.name} has no measured result parser"], None
    try:
        result = json.loads(stdout)
    except json.JSONDecodeError:
        return problems + ["stdout is not a JSON result"], None
    if not isinstance(result, dict) or result.get("type") != "result":
        return problems + ["stdout is not a result object"], None
    if result.get("subtype") != "success" or result.get("is_error") is not False:
        problems.append("result is not a success")
    denials = result.get("permission_denials")
    if not isinstance(denials, list) or denials:
        problems.append("permission_denials is missing or nonempty")
    text = result.get("result")
    if not isinstance(text, str) or not text.strip():
        problems.append("result text is empty")
        text = None
    return problems, text


# Codex exec --json (exec_events.rs of 0.162.1): one JSON object per line.
# Items the tool-less mode may produce; any other item (command_execution,
# file_change, mcp_tool_call, collab_tool_call, web_search, todo_list) is a tool
# use and fails the run. A top-level "error" event is a transient reconnect
# notice and is only counted; an "error" item fails the run except the one
# transport notice below (WebSocket -> HTTPS fallback, seen with a 401 on the host).
CODEX_TEXT_ITEMS = ("agent_message", "reasoning")
CODEX_FALLBACK_NOTICE = "Falling back from WebSockets to HTTPS transport."
# The session logs the server's model (RUST_LOG in CODEX.environment; exec's
# default filter plus codex_core::session at info): "server reported model X
# (matches requested model)" at info, or "... X while requested model was Y" at
# warn (core/src/session/mod.rs), and a reroute also as an item
# "model rerouted: A -> B (...)".
CODEX_SERVER_MODEL = re.compile(
    r"server reported model (\S+) (?:\(matches requested model\)|while requested model was )")
CODEX_REROUTED = re.compile(r"model rerouted: (\S+) -> (\S+)")


def codex_lines(stdout: str) -> list | None:
    """The JSONL events, or None when a nonempty line is not a JSON object."""
    events = []
    for line in stdout.splitlines():
        if not line.strip():
            continue
        try:
            event = json.loads(line)
        except ValueError:
            return None
        if not isinstance(event, dict):
            return None
        events.append(event)
    return events


def codex_events(stdout: str) -> tuple[list[str], str | None]:
    """(problems, report text) of a Codex exec --json stream: one thread, one
    completed turn, text items only, the last agent_message as the report."""
    events = codex_lines(stdout)
    if events is None:
        return ["stdout is not Codex JSONL"], None
    kinds = [event.get("type") for event in events]
    problems = []
    if kinds.count("thread.started") != 1:
        problems.append("stdout does not start exactly one thread")
    if kinds.count("turn.completed") != 1 or "turn.failed" in kinds:
        problems.append("the turn did not complete")
    elif kinds[-1] != "turn.completed":
        problems.append("events follow the completed turn")
    text = None
    for event in events:
        if event.get("type") not in ("item.started", "item.updated", "item.completed"):
            continue
        item = event.get("item")
        kind = item.get("type") if isinstance(item, dict) else None
        if kind == "error":
            message = item.get("message")
            if not (isinstance(message, str) and message.startswith(CODEX_FALLBACK_NOTICE)):
                problems.append("an error item: " + (
                    "model rerouted" if isinstance(message, str) and CODEX_REROUTED.search(message)
                    else "see stdout"))
        elif kind not in CODEX_TEXT_ITEMS:
            problems.append(f"a tool item: {kind}")
        elif kind == "agent_message" and event["type"] == "item.completed":
            text = item.get("text")
    problems = list(dict.fromkeys(problems))
    if not isinstance(text, str) or not text.strip():
        problems.append("result text is empty")
        text = None
    return problems, text


def observed_models(stdout: str, backend: Backend = CLAUDE, stderr: str = "") -> list[str] | None:
    """Model names the result reports, in the backend's shape, if it has any:
    Claude's result JSON names them under modelUsage; Codex's session log line
    on stderr names the server's model, and a rerouted item the model it was
    rerouted to. Another backend has no measured shape yet, so nothing is
    observed (None, never a guess)."""
    if backend.name == CODEX.name:
        names = set(CODEX_SERVER_MODEL.findall(stderr))
        for event in codex_lines(stdout) or []:
            item = event.get("item")
            message = item.get("message") if isinstance(item, dict) else None
            if isinstance(message, str):
                names.update(match[1] for match in CODEX_REROUTED.findall(message))
        return sorted(names) or None
    if backend.name != CLAUDE.name:
        return None
    try:
        usage = json.loads(stdout).get("modelUsage")
    except (ValueError, AttributeError):
        return None
    if not isinstance(usage, dict) or not usage:
        return None
    return sorted(name for name in usage if isinstance(name, str))


def prompt_sha256(prompt: str) -> str:
    """sha256 (lowercase hex) of the validated prompt as the child gets it: the
    text checked_input returned, UTF-8 encoded (the prompt file's own bytes:
    checked_input decodes them strictly and keeps every newline). It is taken from that string,
    never by reopening the file, so a later change to the file cannot move it.
    It binds a result to its input; it is no evidence that a model ran."""
    return hashlib.sha256(prompt.encode("utf-8")).hexdigest()


def collect(run_dir: Path, profile: str, exit_code: int | None,
            stdout: str, stderr: str, failures: list[str] = (),
            relay: dict | None = None, credential: Credential | None = None,
            permission_mode: str | None = None, staged: dict | None = None,
            selection: Selection | None = None, prompt_digest: str | None = None,
            backend: Backend = CLAUDE) -> bool:
    """Record the outcome. The report is data: it is never executed here.

    failures are the supervisor's reasons (timeout, output bound, relay
    ready or exit, cleanup); any one of them fails the run. With a credential,
    a stream or writable-area file holding its exact value fails the run and
    no stream file or report is written; the manifest is written only if it
    does not hold the value either. staged is stage_research_config's record:
    a staged file changed or a configuration file added fails the run.
    """
    moved = parent_path_problems(run_dir)
    if moved:
        print("OSS research worker result not recorded: " + "; ".join(moved),
              file=sys.stderr)
        return False
    result_dir = run_dir / "result"
    relay_stderr = relay.pop("stderr", "") if relay is not None else None
    problems, report_text = result_problems(exit_code, stdout, backend)
    exposed = []
    if credential is not None:
        streams = {"stdout": stdout, "stderr": stderr, "report": report_text or ""}
        try:
            # JSON escapes (\uXXXX) would hide the value from the raw check.
            streams["stdout json"] = json.dumps(json.loads(stdout), ensure_ascii=False)
        except (ValueError, RecursionError):
            if backend.name == CODEX.name:
                # JSONL: each event decoded the same way.
                try:
                    streams["stdout json"] = json.dumps(codex_lines(stdout), ensure_ascii=False)
                except RecursionError:
                    pass
        if relay_stderr is not None:
            streams["relay stderr"] = relay_stderr
        exposed = exposure_problems(run_dir, credential, streams)
    if not exposed:
        (result_dir / "stdout.json").write_text(stdout, encoding="utf-8")
        (result_dir / "stderr.log").write_text(stderr, encoding="utf-8")
        if relay_stderr is not None:
            (result_dir / "relay.log").write_text(relay_stderr, encoding="utf-8")
    problems = exposed + list(failures) + problems + area_problems(run_dir)
    if staged is not None:
        problems += staged_problems(run_dir, staged)
    if credential is not None:
        # A path in a problem may itself hold the value; keep only the fact.
        problems = [item if not credential.found_in(item)
                    else "credential-exposed: problem text" for item in problems]
        failures = [item if not credential.found_in(item)
                    else "credential-exposed: failure text" for item in failures]
    manifest = {
        "status": "failed" if problems else "succeeded",
        "backend": backend.name,
        "profile": profile,
        "exit_code": exit_code,
        "failures": list(failures),
        "problems": problems,
        "policy_sha256": hashlib.sha256(
            (run_dir / "policy/srt-settings.json").read_bytes()).hexdigest(),
    }
    if permission_mode is not None:
        manifest["permission_mode"] = permission_mode
    if prompt_digest is not None:
        manifest["prompt_sha256"] = prompt_digest
    if selection is not None:
        # What the user asked for. It is not what ran: observed_models comes
        # only from the result itself, when it names models.
        manifest["requested_model"] = selection.model
        manifest["requested_effort"] = selection.effort
    observed = observed_models(stdout, backend, stderr)
    if observed is not None:
        manifest["observed_models"] = observed
    if staged is not None:
        manifest["execution_profile"] = staged["profile"]
        manifest["staged"] = staged
    if credential is not None:
        delivery = ({"variable": backend.require("credential_variable")}
                    if backend.credential_file is None else
                    {"file": f"{backend.require('config_subdir')}/{backend.credential_file}"})
        manifest["credential"] = {**delivery,
                                  "exact_value_check": "failed" if exposed else "clean"}
    if relay is not None:
        manifest["relay"] = relay
    if not problems:
        report = result_dir / "report.md"
        report.write_text(report_text, encoding="utf-8")
        report.chmod(0o444)
        manifest["report_sha256"] = hashlib.sha256(report.read_bytes()).hexdigest()
    document = json.dumps(manifest, indent=2)
    if credential is not None and credential.found_in(document):
        print("OSS research worker result not recorded: manifest would hold the credential",
              file=sys.stderr)
        return False
    (result_dir / "manifest.json").write_text(document, encoding="utf-8")
    return not problems


def write_login(path: Path, credential: Credential) -> None:
    """The parent's copy of a login file in the run (0600, new file, no link)."""
    data = credential.reveal().encode("utf-8")
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        view = memoryview(data)
        while view:
            view = view[os.write(descriptor, view):]
    finally:
        os.close(descriptor)


def remove_login(path: Path, credential: Credential) -> bool:
    """Remove the run's login copy; True when it was still exactly the parent's.

    Whatever is at the path is removed (a link is unlinked, not followed), so
    the exposure scan after it never meets the parent's own copy."""
    unchanged = False
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        descriptor = None
    if descriptor is not None:
        try:
            if stat.S_ISREG(os.fstat(descriptor).st_mode):
                data = b""
                while chunk := os.read(descriptor, 1 << 16):
                    data += chunk
                unchanged = data == credential.reveal().encode("utf-8")
        finally:
            os.close(descriptor)
    try:
        if path.is_dir() and not path.is_symlink():
            shutil.rmtree(path)
        else:
            path.unlink()
    except FileNotFoundError:
        pass
    except OSError:
        return False
    return unchanged


def run_supervised(input_dir: Path, run_dir: Path, profile: str, seconds: float,
                   relay: RelayLaunch | None, policy_for, command_for,
                   environment: dict[str, str], credential: Credential | None = None,
                   permission_mode: str | None = None, stage=None,
                   selection: Selection | None = None, prompt_digest: str | None = None,
                   record=None, backend: Backend = CLAUDE) -> bool:
    """Start the relay (if any) and the sandboxed child under one deadline.

    policy_for(port) builds the policy once the relay's ready line checked out
    (port is None without a relay or when it failed); command_for(policy_file)
    builds the sandboxed child argv. Both groups are killed on every exit. A
    start failure is recorded in the manifest; an OSError from prepare_run
    (the run directory itself) propagates, since no manifest can be trusted then.
    A credential loaded for another profile is Blocked before any directory,
    process or value use. A credential is refused anywhere but the child's environment: in the relay's
    argv or environment, or in the child's argv, nothing of that process starts.
    stage(run_dir), when given, stages the configuration after prepare_run and
    returns its record; a Blocked from it is recorded and the child never starts.
    record, when given, replaces collect for a child that is no model run (the
    non-AI collection entry): record(run_dir, exit_code, stdout, stderr,
    failures, relay_record) -> bool. A model run always goes through collect.
    """
    require_profile(credential, profile)
    if record is not None and credential is not None:
        raise Blocked("a credential run is a model run; its result goes through collect")
    supervisor = Supervisor(seconds)
    port, relay_record, relay_process, exit_code = None, None, None, None
    staged_record = None
    def holds(strings) -> bool:
        return credential is not None and any(credential.found_in(item) for item in strings)

    login_file = None

    try:
        if relay is not None:
            relay_record = {"sources": relay.sources, "relay_sha256": relay.relay_sha256,
                            "port": None}
            if holds([*relay.argv, *relay.environment, *relay.environment.values()]):
                supervisor.fail("credential-in-relay")
            else:
                try:
                    relay_process = supervisor.start(relay.argv, relay.environment, input_dir)
                except TimeoutError:
                    supervisor.fail("timeout")
                except OSError as error:
                    supervisor.fail(f"relay-not-started: {type(error).__name__}")
            line = supervisor.read_ready(relay_process) if relay_process else None
            if line is not None:
                try:
                    port = checked_ready(line, relay.sources)
                except ValueError as error:
                    supervisor.fail(f"relay-not-ready: {error}")
            relay_record["port"] = port
        policy_file = prepare_run(run_dir, policy_for(port), backend)
        if stage is not None and not supervisor.failures:
            try:
                staged_record = stage(run_dir)
            except Blocked as error:
                supervisor.fail(f"staging-blocked: {error}")
        if credential is not None and backend.credential_file is not None \
                and not supervisor.failures:
            login_file = run_dir / backend.require("config_subdir") / backend.credential_file
            write_login(login_file, credential)
        command = command_for(policy_file)
        if holds(command):
            supervisor.fail("credential-in-argv")
        if not supervisor.failures:
            try:
                child = supervisor.start(command, environment, input_dir)
            except TimeoutError:
                supervisor.fail("timeout")
            except OSError as error:
                supervisor.fail(f"child-not-started: {type(error).__name__}")
            else:
                exit_code = supervisor.run(child, relay_process)
    finally:
        supervisor.cleanup()
        if login_file is not None:
            # Removed before collect scans the run; changed means the child
            # (or a refresh) rewrote the login, which fails the run.
            if not remove_login(login_file, credential):
                supervisor.fail("credential-file-changed")
    if relay_record is not None:
        relay_record["stderr"] = text(supervisor.data["relay stderr"])
    if supervisor.failures:
        exit_code = None
    if record is not None:
        return record(run_dir, exit_code, text(supervisor.data["stdout"]),
                      text(supervisor.data["stderr"]), list(supervisor.failures), relay_record)
    return collect(run_dir, profile, exit_code, text(supervisor.data["stdout"]),
                   text(supervisor.data["stderr"]), supervisor.failures, relay_record,
                   credential, permission_mode, staged_record, selection, prompt_digest,
                   backend)


def run_research(runtime: list[str], cli: str, prompt: str, input_dir: Path,
                 run_dir: Path, profile: str, seconds: float,
                 relay: RelayLaunch | None, parent: dict[str, str],
                 permission_mode: str = DEFAULT_PERMISSION_MODE,
                 credential: Credential | None = None,
                 staged: StagedRun | None = None,
                 selection: Selection | None = None,
                 backend: Backend = CLAUDE) -> bool:
    """The model run: model endpoint plus the relay port once it is ready.

    A run with a credential is a live model run: it needs the user's explicit
    selection (model and effort) and is Blocked before anything without one.

    Reached only past require_runtime, which is closed; tests call it directly.
    A credential of another profile is Blocked before anything is built.
    Without staged it is the read-only run exactly as before; with it, the
    profile's configuration is staged and its argv and policy are used.
    The backend's argv, environment and policy are built; a backend without
    measured ones (agy) is Blocked before any directory exists. A Codex run is
    the read-only one only (no staged profile), always with its login file
    (without one Codex would go to the API-key endpoint), and only while that
    login needs no refresh within seconds (codex_credential_problems).
    """
    require_profile(credential, profile)
    if selection is not None:
        selection.check()
    elif credential is not None:
        raise Blocked("a live run needs the user's explicit --model and --effort; "
                      "no default is chosen")
    if backend.name == CODEX.name:
        if staged is not None:
            raise Blocked("backend codex has no staged profile; the isolated launch stays closed")
        if credential is None:
            raise Blocked("a codex run needs its ChatGPT login file; none was loaded")
        if profile not in backend.require("profiles"):
            raise Blocked(f"profile {profile} is not a codex profile")
        stale = codex_credential_problems(credential, seconds)
        if stale:
            raise Blocked("; ".join(stale))
    else:
        require_measured_argv(backend)
    if staged is None:
        return run_supervised(
            input_dir, run_dir, profile, seconds, relay,
            lambda port: build_policy(input_dir, run_dir, Path(cli), port,
                                      runtime=runtime, backend=backend),
            lambda policy_file: build_command(runtime, policy_file, cli, prompt,
                                              permission_mode, selection, backend),
            build_environment(parent, run_dir, credential, backend=backend), credential,
            permission_mode, selection=selection, prompt_digest=prompt_sha256(prompt),
            backend=backend)
    staged.check()
    checked_staged_input(input_dir)
    return run_supervised(
        input_dir, run_dir, profile, seconds, relay,
        lambda port: build_policy(input_dir, run_dir, Path(cli), port, staged=staged,
                                  runtime=runtime, backend=backend),
        lambda policy_file: build_staged_command(runtime, policy_file, cli, prompt,
                                                 run_dir, staged, permission_mode, selection,
                                                 backend),
        build_environment(parent, run_dir, credential, backend=backend), credential,
        permission_mode, lambda directory: stage_research_config(directory, staged), selection,
        prompt_sha256(prompt), backend=backend)


def positive_seconds(value: str) -> float:
    seconds = float(value)
    if not math.isfinite(seconds) or seconds <= 0:
        raise argparse.ArgumentTypeError("timeout must be a positive finite number")
    return seconds


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--profile", required=True, choices=ALL_PROFILES,
                        help="claude-profile1|2 for --backend claude, codex-profile1 for codex")
    parser.add_argument("--backend", choices=tuple(BACKENDS), default=DEFAULT_BACKEND,
                        help="the model CLI for the child (default claude). Only claude "
                             "has a measured launch; the others are blocked at the gate")
    parser.add_argument("--input-dir", required=True, type=Path)
    parser.add_argument("--prompt-file", required=True, type=Path)
    parser.add_argument("--run-dir", required=True, type=Path)
    parser.add_argument("--runtime-prefix", type=Path,
                        help=f"local npm prefix holding {SRT_PACKAGE}@{SRT_VERSION}")
    parser.add_argument("--credential-file", type=Path,
                        help=f"<dir>/<profile>/{CREDENTIAL_NAME} made by the user")
    parser.add_argument("--model",
                        help="the model for the child, exactly as the user names it "
                             "(passed to claude --model); no default")
    parser.add_argument("--effort", choices=EFFORT_LEVELS,
                        help="the effort for the child (passed to claude --effort); no default")
    # dontAsk only (#4 item 1, decided 2026-10-11): auto was measured three times
    # (2026-09-28 twice, 2026-10-11) with no OS-level evidence, so it is refused
    # as input. build_command keeps PERMISSION_MODES for the measurement harness.
    parser.add_argument("--permission-mode", choices=(DEFAULT_PERMISSION_MODE,),
                        default=DEFAULT_PERMISSION_MODE,
                        help="Claude permission mode for the child: dontAsk only. auto was "
                             "measured three times (2026-09-28 x2, 2026-10-11) with no OS-level "
                             "evidence and is refused as input")
    parser.add_argument("--execution-profile", choices=EXECUTION_PROFILES,
                        default=DEFAULT_EXECUTION_PROFILE,
                        help="read-only (default) is the restricted run; corpus-extract "
                             "and deep-research stage reviewed skill sources in a separate run")
    parser.add_argument("--web-domain", action="append", default=[],
                        help="a host deep-research may WebFetch; repeat for more. "
                             "Default none; GitHub domains are refused")
    parser.add_argument("--timeout", type=positive_seconds,
                        default=DEFAULT_TIMEOUT_SECONDS,
                        help="one wall-clock limit over the relay and the child")
    parser.add_argument("--relay-repo", action="append", default=[],
                        help="OWNER/NAME the read-only relay may read; repeat for more. "
                             "Without it no relay starts")
    parser.add_argument("--relay-request-budget", type=int, default=100)
    parser.add_argument("--relay-max-response-bytes", type=int, default=4 * 1024 * 1024)
    parser.add_argument("--relay-response-byte-budget", type=int, default=64 * 1024 * 1024)
    parser.add_argument("--relay-timeout-seconds", type=float, default=30.0)
    arguments = parser.parse_args()
    parent = dict(os.environ)  # read once; only allowlisted names reach any child
    try:
        guarded = parent_eof_guard(parent)
    except Blocked as error:
        print(f"OSS research worker blocked: {error}", file=sys.stderr)
        return EXIT_BLOCKED
    try:
        input_dir, prompt = checked_input(
            arguments.input_dir, arguments.prompt_file, Path.home())
        run_dir = checked_run_dir(arguments.run_dir, input_dir)
        relay_request = checked_relay_request(
            arguments.relay_repo, arguments.relay_request_budget,
            arguments.relay_max_response_bytes, arguments.relay_response_byte_budget,
            arguments.relay_timeout_seconds) if arguments.relay_repo else None
        if (arguments.model is None) != (arguments.effort is None):
            raise ValueError("give --model and --effort together, or neither")
        profiles = BACKENDS[arguments.backend].profiles
        if profiles is not None and arguments.profile not in profiles:
            raise ValueError(f"--profile {arguments.profile} is not a {arguments.backend} profile")
        selection = Selection(arguments.model, arguments.effort).check() \
            if arguments.model is not None else None
        if arguments.execution_profile == DEFAULT_EXECUTION_PROFILE:
            if arguments.web_domain:
                raise ValueError("web domains are for the deep-research profile only")
            staged = None
        else:
            # The reviewed source root is resolved past the gate (reviewed_source_root).
            staged = StagedRun(arguments.execution_profile, Path(),
                               tuple(arguments.web_domain)).check()
            checked_staged_input(input_dir)
    except (OSError, UnicodeError, ValueError) as error:
        print(f"OSS research worker did not start: {error}", file=sys.stderr)
        return EXIT_BAD_INPUT
    backend = BACKENDS[arguments.backend]
    try:
        runtime, cli, credential = require_runtime(
            arguments.profile, arguments.runtime_prefix, parent.get("PATH"),
            arguments.credential_file, (input_dir, run_dir),
            launch=LaunchRequest(arguments.execution_profile, arguments.permission_mode,
                                 relay_request is not None, selection,
                                 tuple(unit_problems(parent, guarded)), backend.name),
            backend=backend)
        # Past the gate a model run starts next: without the user's explicit
        # model and effort it never does, and no default is picked.
        if selection is None:
            raise Blocked("a model run needs the user's explicit --model and --effort; "
                          "no default is chosen")
        relay = relay_launch(relay_request, parent) if relay_request else None
        if staged is not None:
            staged = staged._replace(source_root=reviewed_source_root(Path(__file__)))
    except (Blocked, OSError) as error:
        print(f"OSS research worker blocked: {error}", file=sys.stderr)
        return EXIT_BLOCKED
    try:
        succeeded = run_research(runtime, cli, prompt, input_dir, run_dir, arguments.profile,
                                 arguments.timeout, relay, parent,
                                 arguments.permission_mode, credential, staged, selection,
                                 backend=backend)
    except Blocked as error:
        print(f"OSS research worker blocked: {error}", file=sys.stderr)
        return EXIT_BLOCKED
    except (OSError, subprocess.SubprocessError) as error:
        print(f"OSS research worker failed: {error}", file=sys.stderr)
        return EXIT_FAILED
    print(run_dir / "result/manifest.json")
    return 0 if succeeded else EXIT_FAILED


if __name__ == "__main__":
    raise SystemExit(main())
