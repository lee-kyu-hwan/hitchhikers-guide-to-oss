{
  "schema_version": "1.0.0",
  "purpose": "LEGACY FIXTURE ONLY: mock manifests written before the worker recorded observed_models and prompt_sha256. Never for a live run; the verifier refuses --adopt-to with it.",
  "require_observed_model": false,
  "require_prompt_sha256": false,
  "source_repositories": [
    "eslint-markdown/eslint-markdown",
    "eslint/markdown"
  ],
  "interval_days": 30,
  "max_per_repository": 3,
  "max_prs": 6,
  "relay_request_budget": 60,
  "prompt_lens": "blind",
  "prompt_max_bytes": 65536,
  "report_max_bytes": 262144,
  "max_patterns": 5,
  "max_observations": 20,
  "max_rejected": 20,
  "synthesis_max_candidates": 3,
  "candidate_max_bytes": 1024,
  "extract_answer_max_bytes": 7680,
  "candidate_statement_max_chars": 600,
  "verify_answer_max_bytes": 5120,
  "final_dynamic_reserve_bytes": 8192,
  "worker": {
    "profile": "claude-profile2",
    "model": "claude-opus-5-5",
    "effort": "medium",
    "permission_mode": "auto",
    "execution_profile": "read-only"
  },
  "target_repositories": [
    "eslint-markdown/eslint-markdown"
  ],
  "legacy_fixture": true
}
