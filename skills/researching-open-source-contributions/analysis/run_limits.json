{
  "schema_version": "1.0.0",
  "purpose": "#78 actual E2E limits the verifier enforces (docs/research/oss-e2e-2026-09-28/README.md); the corpus size caps come from the request file, the model call limit from the shard count",
  "require_observed_model": true,
  "require_prompt_sha256": true,
  "source_repositories": [
    "eslint-markdown/eslint-markdown",
    "eslint/markdown"
  ],
  "interval_days": 30,
  "relay_request_budget": 60,
  "prompt_lens": "blind",
  "prompt_max_bytes": 65536,
  "report_max_bytes": 262144,
  "max_patterns": 5,
  "max_observations": 20,
  "max_rejected": 20,
  "synthesis_max_candidates": 3,
  "candidate_max_bytes": 1024,
  "extract_answer_max_bytes": 7680,
  "extract_answer_target_bytes": 6500,
  "candidate_statement_max_chars": 600,
  "verify_answer_max_bytes": 5120,
  "final_dynamic_reserve_bytes": 8192,
  "model_retry": {
    "per_call": 1,
    "per_stage": 3,
    "total": 5
  },
  "worker": {
    "profile": "claude-profile2",
    "model": "claude-opus-5-5",
    "effort": "medium",
    "permission_mode": "dontAsk",
    "execution_profile": "read-only"
  },
  "target_repositories": [
    "eslint-markdown/eslint-markdown"
  ]
}
