EFFORT_LEVELS = ("low", "medium", "high", "xhigh", "max")
# One opaque argument: printable ASCII without spaces, 1-128 characters, not
# starting with "-". It keeps every form the CLI accepts (claude-opus-5-5[1m]).
MODEL_NAME = re.compile(r"[!-,.-~][!-~]{0,127}")


class Blocked(Exception):
    """The isolated launch cannot start; never fall back to an unisolated one."""


class Backend(NamedTuple):
    """One model CLI as the runner drives it (issue #6, the seven Claude dependencies).

    A field that is None is not measured for that backend yet; anything that
    needs it is Blocked (require). Only name and executable are always set.
    The argv builders (build_command, build_staged_command) and the result
    parsers (result_problems, observed_models) dispatch on name: the Claude
    and Codex ones are written, the others stay closed until measured.

    The credential reaches the child one of two ways (credential_variable or
    credential_file, never both): Claude takes a token in one variable; Codex
    reads <config home>/auth.json, which the parent writes into the run and
    removes after it (run_supervised).
    """
    name: str
    executable: str                              # found on PATH past the gate
    credential_name: str | None                  # <dir>/<profile>/<credential_name>
    credential_variable: str | None              # the one variable the child gets it in
    config_variable: str | None                  # the CLI's configuration-home variable
    config_subdir: str | None                    # ... pointed at run/<config_subdir>
    allowed_domains: tuple[str, ...] | None      # model endpoint (macOS form)
    allowed_domains_linux: tuple[str, ...] | None  # the same with :443 (Linux form)
    pinned_names: tuple[str, ...] | None         # names the egress pin resolves for a run
    profiles: tuple[str, ...] | None = None      # --profile names this backend takes
    credential_file: str | None = None           # run/<config_subdir>/<credential_file>
    environment: tuple[tuple[str, str], ...] = ()  # fixed child variables
    system_read_linux: tuple[str, ...] = ()      # read paths beyond SYSTEM_READ_LINUX
    config_unwritable: tuple[str, ...] = ()      # dirs under the config home: made, never written

    def require(self, field: str):
        value = getattr(self, field)
        if value is None:
            raise Blocked(f"backend {self.name} has no measured {field.replace('_', ' ')}; "
                          "the isolated launch stays closed")
        return value


# The Claude backend is the measured one: its fields are the module constants.
CLAUDE = Backend(
